# TRENDARYO Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to version control!
# Set these in your Vercel dashboard under Settings > Environment Variables

# ── Firebase (Server-side Admin SDK) ──
FIREBASE_PROJECT_ID=trendaryo
FIREBASE_CLIENT_EMAIL=your-service-account@trendaryo.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"
# Optional: whole service-account JSON on one line (Vercel-safe, used if split vars are absent)
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----","client_email":"firebase-adminsdk-...@your-project.iam.gserviceaccount.com"}

# ── Stripe ──
# IMPORTANT: Use sk_live_ and pk_live_ for production!
STRIPE_SECRET_KEY=sk_test_YOUR_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# ── JWT ──
JWT_SECRET=YOUR_64_CHAR_HEX_JWT_SECRET
REFRESH_TOKEN_SECRET=YOUR_64_CHAR_HEX_REFRESH_SECRET

# ── Backend ──
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ── Cloudinary ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Vercel ──
# VERCEL_ENV is automatically set by Vercel (production, preview, development)
